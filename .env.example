# Скопируйте в .env и заполните своими значениями (см. ИНСТРУКЦИЯ_ПОЛЬЗОВАТЕЛЯ.md).
# .env не попадает в git (.gitignore).

# Обязательно https://; http:// разрешён только для localhost/127.0.0.1 (валидация в CLI).
SNE_AI_BASE_URL=https://api.example.com/v1

# Название модели на этом endpoint (любой OpenAI-совместимый шлюз).
SNE_AI_MODEL=your-model-name

# Ключ вашего endpoint. Отсюда (env/.env) - без ключей в CLI и не в git.
SNE_AI_API_KEY=sk-your-key

# Telegram-бот доставки карточек (необязательно: @BotFather → токен, затем /start боту).
TG_BOT_TOKEN=

# GitHub PAT для модуля outreach (поиск контактов по коммитам компаний;
# достаточно public_repo; без токена — анонимный лимит 60/час).
GITHUB_TOKEN=github_pat_your_token
